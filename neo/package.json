{
  "name": "illusions",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "app": "concurrently -k -n server,web,app -c cyan,magenta,green \"npm run dev:server\" \"npm run dev:web\" \"wait-on http://127.0.0.1:5174 http://127.0.0.1:8787/api/health && electron . --no-sandbox\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build && npm run build:server",
    "build:server": "esbuild server/packaged.ts --bundle --platform=node --format=esm --outfile=dist-server/index.js --packages=external",
    "dist": "npm run build && electron-builder --win portable --x64",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64",
    "preview": "vite preview --port 5174",
    "start": "tsx server/index.ts"
  },
  "build": {
    "appId": "app.illusions.desktop",
    "productName": "Illusions",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Illusions.exe"
    },
    "linux": {
      "target": ["AppImage"],
      "artifactName": "Illusions-${version}.${ext}"
    }
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.32",
    "@ai-sdk/react": "^2.0.32",
    "@ai-sdk/xai": "^2.0.23",
    "@modelcontextprotocol/sdk": "^1.17.4",
    "@hono/node-server": "^1.19.1",
    "ai": "^5.0.32",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "framer-motion": "^12.23.12",
    "highlight.js": "^11.11.1",
    "hono": "^4.9.8",
    "idb": "^8.0.3",
    "lucide-react": "^0.542.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "concurrently": "^9.2.1",
    "wait-on": "^8.0.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
